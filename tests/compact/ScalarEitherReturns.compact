pragma language_version 0.28;
import CompactStandardLibrary;

export circuit canonicalize(
  isLeft: Boolean,
  leftValue: Uint<8>,
  rightValue: Uint<16>
): Either<Uint<8>, Uint<16>> {
  return isLeft
    ? Either<Uint<8>, Uint<16>> {
        is_left: true,
        left: leftValue,
        right: default<Uint<16>>
      }
    : Either<Uint<8>, Uint<16>> {
        is_left: false,
        left: default<Uint<8>>,
        right: rightValue
      };
}
