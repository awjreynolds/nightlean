pragma language_version 0.28;
import CompactStandardLibrary;

export ledger total: Counter;
export ledger epochs: Map<Bytes<32>, Map<Bytes<32>, Counter>>;

export circuit seed(): [] {
  total.increment(10);
}

export circuit apply(owner: Bytes<32>, spender: Bytes<32>, amount: Uint<16>): [Uint<64>, Uint<64>] {
  const ownerKey = disclose(owner);
  const spenderKey = disclose(spender);
  const value = disclose(amount);
  if (!epochs.member(ownerKey)) { epochs.insertDefault(ownerKey); }
  if (!epochs.lookup(ownerKey).member(spenderKey)) {
    epochs.lookup(ownerKey).insertDefault(spenderKey);
  }
  total.increment(value);
  epochs.lookup(ownerKey).lookup(spenderKey).increment(value);
  return [total.read(), epochs.lookup(ownerKey).lookup(spenderKey).read()];
}

export circuit reduce(owner: Bytes<32>, spender: Bytes<32>, amount: Uint<16>): [Uint<64>, Uint<64>] {
  const ownerKey = disclose(owner);
  const spenderKey = disclose(spender);
  const value = disclose(amount);
  total.decrement(value);
  epochs.lookup(ownerKey).lookup(spenderKey).decrement(value);
  return [total.read(), epochs.lookup(ownerKey).lookup(spenderKey).read()];
}

export circuit guarded(owner: Bytes<32>, spender: Bytes<32>, amount: Uint<16>, enabled: Boolean): [] {
  if (disclose(enabled)) {
    epochs.lookup(disclose(owner)).lookup(disclose(spender)).increment(disclose(amount));
  }
}
