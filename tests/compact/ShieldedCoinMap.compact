pragma language_version 0.28;
import CompactStandardLibrary;

export ledger pot: Map<Bytes<32>, QualifiedShieldedCoinInfo>;

export circuit tip(coin: ShieldedCoinInfo): [] {
  const nonce = disclose(coin.nonce);
  assert(!pot.member(nonce), "coin nonce already received");
  receiveShielded(disclose(coin));
  pot.insertCoin(
    nonce,
    disclose(coin),
    right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
  );
}

export circuit storeWithoutReceive(coin: ShieldedCoinInfo): [] {
  pot.insertCoin(
    disclose(coin.nonce),
    disclose(coin),
    right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
  );
}

export circuit withdraw(nonce: Bytes<32>, recipient: ZswapCoinPublicKey): [] {
  assert(pot.member(disclose(nonce)), "coin nonce missing");
  const coin = pot.lookup(disclose(nonce));
  const result = sendShielded(
    coin,
    left<ZswapCoinPublicKey, ContractAddress>(disclose(recipient)),
    coin.value
  );
  assert(!result.change.is_some, "full send must have no change");
  pot.remove(disclose(nonce));
}

export circuit withdrawPartial(
  nonce: Bytes<32>,
  recipient: ZswapCoinPublicKey,
  quantity: Uint<128>
): [] {
  const key = disclose(nonce);
  assert(pot.member(key), "coin nonce missing");
  const coin = pot.lookup(key);
  const amount = disclose(quantity);
  assert(amount > 0 && amount < coin.value, "partial send must leave change");
  const result = sendShielded(
    coin,
    left<ZswapCoinPublicKey, ContractAddress>(disclose(recipient)),
    amount
  );
  assert(result.change.is_some, "partial send must have change");
  const change = result.change.value;
  pot.remove(key);
  pot.insertCoin(
    change.nonce,
    change,
    right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
  );
}

export circuit relayImmediate(
  coin: ShieldedCoinInfo,
  target: ContractAddress,
  entryHash: Bytes<32>,
  opening: Field
): [] {
  const incoming = disclose(coin);
  const recipient = disclose(target);
  receiveShielded(incoming);
  const result = sendImmediateShielded(
    incoming,
    right<ZswapCoinPublicKey, ContractAddress>(recipient),
    incoming.value
  );
  assert(!result.change.is_some, "full relay must have no change");
  const commitment = transientCommit<ShieldedCoinInfo>(result.sent, opening);
  kernel.claimContractCall(recipient.bytes, disclose(entryHash), disclose(commitment));
}
