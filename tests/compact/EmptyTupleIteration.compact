pragma language_version >= 0.28;
import CompactStandardLibrary;

export ledger total: Field;
witness seed(): Field;
witness empty(slot: Field): [];
witness callback(): Field;

export circuit update(): Field {
  const sum = fold((acc, mapped, right) => acc + callback(),
    seed(),
    map((left, right) => callback(), empty(1 as Field), empty(2 as Field)),
    empty(3 as Field));
  total = disclose(sum);
  return disclose(sum);
}
