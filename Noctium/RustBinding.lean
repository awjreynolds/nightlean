import Lean

namespace Noctium.RustBinding
open Lean

private def hex (n : Nat) : String := String.ofList (Nat.toDigits 16 n)

private def literal (text : String) : String :=
  "\"" ++ String.join (text.toList.map fun c =>
    if c == '"' then "\\\"" else if c == '\\' then "\\\\"
    else if c.toNat < 32 || c.toNat == 127 then "\\u{" ++ hex c.toNat ++ "}"
    else String.singleton c) ++ "\""

private def identifier (text : String) : String := String.join (text.toList.map fun c =>
  if c == '_' then "__"
  else if c == '.' then "_d"
  else if c.toNat < 128 && c.isAlphanum then String.singleton c
  else "_u" ++ hex c.toNat ++ "_")

private def parameterNat (token tag : String) : Option Nat := do
  if !(token.startsWith tag && token.endsWith ">") then none else
    ((token.drop tag.length).dropEnd 1).toString.toNat?

private def rustType (token : String) : String :=
  match token with
  | "Bool" => "bool"
  | "Unit" => "()"
  | "Native" | "JubjubScalar" => "String"
  | "JubjubPoint" => "(String, String)"
  | _ =>
    if let some length := parameterNat token "Bytes<" then s!"[u8; {length}]"
    else if let some exclusive := parameterNat token "UIntRange<" then
      if let some bits := [8, 16, 32, 64, 128].find? (fun bits => exclusive ≤ 2 ^ bits) then
        s!"u{bits}"
      else "String"
    else "Json"

private def encode (token value : String) : String :=
  match token with
  | "Bool" => s!"Json::Bool({value})"
  | "Unit" => "{ let () = " ++ value ++ "; Json::Null }"
  | "Native" => s!"Json::String({value})"
  | "JubjubScalar" => "serde_json::json!({\"kind\": \"jubjubScalar\", \"value\": " ++ value ++ "})"
  | "JubjubPoint" => "serde_json::json!({\"kind\": \"jubjubPoint\", \"x\": " ++ value ++
      ".0, \"y\": " ++ value ++ ".1})"
  | _ =>
    if (parameterNat token "Bytes<").isSome then
      "serde_json::json!({\"kind\": \"bytes\", \"values\": " ++ value ++ ".as_slice()})"
    else if (parameterNat token "UIntRange<").isSome then
      if rustType token == "String" then s!"Json::String({value})" else s!"Json::String({value}.to_string())"
    else value

def generate (controlFile : String) (binding : Json) : Except String String := do
  let inputs : Array Json ← binding.getObjValAs? (Array Json) "inputBindings"
  let providers : Array Json ← binding.getObjValAs? (Array Json) "signatures"
  let mut fields := []
  let mut values := []
  for input in inputs do
    let name ← input.getObjValAs? String "name"
    let token ← input.getObjValAs? String "type"
    let field := "arg_" ++ identifier name
    fields := fields ++ [s!"    pub {field}: {rustType token},"]
    values := values ++ [s!"            ({literal name}.into(), {encode token ("self." ++ field)}),"]
  let mut replies := []
  for provider in providers do
    let name ← provider.getObjValAs? String "name"
    let operation ← provider.getObjValAs? String "operation"
    let capability ← provider.getObjValAs? String "capability"
    let token ← provider.getObjValAs? String "resultType"
    let function := "reply_" ++ identifier name
    replies := replies ++ ["", "#[allow(non_snake_case)]",
      s!"pub fn {function}(request: &Json, attempt_id: &str, value: {rustType token}) -> Result<TypedResponse, Error> " ++ "{",
      "    GeneratedBinding::reply(request, attempt_id, (",
      s!"        {literal name}, {literal operation}, {literal capability}, {literal token},",
      s!"    ), {encode token "value"})", "}"]
  return String.intercalate "\n" (["// Generated by Noctium. Include this file as a Rust module.",
    "use std::collections::BTreeMap;",
    "use noctium_runtime::{artifacts::VerifiedBundle, " ++
      (if providers.isEmpty then "" else "control::TypedResponse, ") ++ "host::Context,",
    "    proof::{ContractOperationTarget, CurrentStateContext, TrustedParameters, WitnessTarget},",
    "    witness_execution::{Error, GeneratedBinding, WitnessExecution}};",
    "use serde_json::Value as Json;", "",
    "pub const BINDING: GeneratedBinding = GeneratedBinding::new(",
    s!"    include_bytes!({literal ("../../" ++ controlFile)}),", ");", "",
    "#[allow(non_snake_case)]", "pub struct Inputs {"] ++ fields ++ ["}", "", "impl Inputs {",
    "    pub fn into_source_inputs(self) -> BTreeMap<String, Json> {",
    "        BTreeMap::from(["] ++ values ++ ["        ])", "    }", "",
    "    pub fn from_target(self, bundle: &VerifiedBundle, target: WitnessTarget,",
    "        context: Context, parameters: &TrustedParameters, ttl: u64)",
    "        -> Result<WitnessExecution, Error> {",
    "        BINDING.check_bundle(bundle)?;",
    "        WitnessExecution::from_target(bundle, target, self.into_source_inputs(), context, parameters, ttl)",
    "    }", "",
    "    pub fn begin_contract_operation(self, target: &ContractOperationTarget,",
    "        state: &mut Option<CurrentStateContext>, context: Context, parameters: &TrustedParameters)",
    "        -> Result<WitnessExecution, Error> {",
    "        BINDING.check_operation(target)?;",
    "        WitnessExecution::begin_contract_operation(target, state, self.into_source_inputs(), context, parameters)",
    "    }", "}"] ++ replies)

end Noctium.RustBinding
