import Nightlean.Verification.GenericStateNativeReadNames

namespace Nightlean.Verification.GenericStateReadTape
open Backend

/-- Read metadata contributed by one actual source effect. The ordinal is the
current production read count, including the public-input prefix. -/
def effectReadChunk (effect : Effect) (ordinal : Nat) : List Impact.Read :=
  match effect with
  | .readCell _ destination ty => [{name := destination, ty}]
  | .requireAbsent .. =>
    [{name := GenericStateNativeReadNames.absenceName ordinal, ty := .bool}]
  | _ => []

/-- One chunk per source effect, preserving empty chunks and exact ordinals. -/
def readChunks : List Effect → Nat → List (List Impact.Read)
  | [], _ => []
  | effect :: rest, ordinal =>
    let chunk := effectReadChunk effect ordinal
    chunk :: readChunks rest (ordinal + chunk.length)

/-- Production appendEffect appends exactly the corresponding metadata chunk. -/
theorem appendEffect_read_chunk (state : List StateDecl) (effect : Effect)
    (before after : Impact.Plan)
    (accepted : Impact.appendEffect state effect before = .ok after) :
    after.reads = before.reads ++ effectReadChunk effect before.reads.length := by
  have same :
      Impact.Plan.reads <$> Impact.appendEffect state effect before =
      (fun _ => before.reads ++ effectReadChunk effect before.reads.length) <$>
        Impact.appendEffect state effect before := by
    cases effect <;>
      simp only [Impact.appendEffect, effectReadChunk,
        GenericStateNativeReadNames.absenceName, map_bind,
        LawfulApplicative.map_pure, List.append_nil] <;> rfl
  rw [accepted] at same
  exact Except.ok.inj same

private theorem bind_ok {α β : Type} {first : Except ε α}
    {next : α → Except ε β} {result : β} :
    (first >>= next) = .ok result ↔
      ∃ value, first = .ok value ∧ next value = .ok result := by
  cases first <;> simp [Bind.bind, Except.bind]

/-- The actual production fold preserves read chunk order and current-count
ordinals. Unsupported source effects require no invented read metadata. -/
theorem appendEffects_read_chunks (state : List StateDecl) (effects : List Effect)
    (before after : Impact.Plan)
    (accepted : Impact.appendEffects state effects before = .ok after) :
    after.reads = before.reads ++ (readChunks effects before.reads.length).flatten := by
  induction effects generalizing before with
  | nil =>
    change Except.ok before = .ok after at accepted
    cases accepted
    simp [readChunks]
  | cons effect rest ih =>
    simp only [Impact.appendEffects, List.foldlM_cons, bind_ok] at accepted
    obtain ⟨middle, first, later⟩ := accepted
    have shape := appendEffect_read_chunk state effect before middle first
    rw [ih middle later, shape]
    simp only [readChunks, List.length_append, List.flatten_cons, List.append_assoc]

/-- Every read after the public-input prefix is generated by the actual source
effect sequence, with its exact type, generated name and ordinal. -/
theorem lower_read_chunks (state : List StateDecl) (ep : Entrypoint)
    (plan : Impact.Plan) (accepted : Impact.lower state ep = .ok plan) :
    plan.reads.drop ((ep.circuit.inputs.filter (·.visibility == .«public»)).length) =
      (readChunks ep.effects
        ((ep.circuit.inputs.filter (·.visibility == .«public»)).length)).flatten := by
  let initial := Impact.publicInputPlan ep.circuit.inputs {}
  have prefixLength : initial.reads.length =
      (ep.circuit.inputs.filter (·.visibility == .«public»)).length := by
    simp only [initial, GenericStateNativeReadNames.publicInputPlan_reads,
      List.nil_append, List.length_map]
  have shape := appendEffects_read_chunks state ep.effects initial plan
    (GenericStateAdmission.lower_effect_fold state ep plan accepted)
  rw [shape, ← prefixLength, List.drop_left]

end Nightlean.Verification.GenericStateReadTape
